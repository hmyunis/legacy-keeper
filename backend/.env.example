# Core Django
DEBUG=True
SECRET_KEY=your-super-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://legacy_user:legacy_pass@localhost:5432/legacy_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO)
USE_MINIO=False
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=legacykeeper

# Maileroo (Email Notifications)
USE_MAILEROO=False
MAILEROO_API_KEY=your-maileroo-api-key
DEFAULT_FROM_EMAIL=museum@yourfamily.com
DEFAULT_FROM_NAME="LegacyKeeper Museum"

# VAPID (Web Push Notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_ADMIN_EMAIL=admin@yourfamily.com

# Hugging Face (For faster/unlimited AI model downloads)
HF_TOKEN=your-huggingface-token-here